-	fd = open(fastrpc_node, O_RDWR);
+	if (getenv("HEXAGONRPC_WARM_ATTACH")) {
+		struct timespec ts = {0, 20000};
+		int tries = 0;
+		do {
+			fd = open(fastrpc_node, O_RDWR);
+			if (fd >= 0)
+				break;
+			nanosleep(&ts, NULL);
+		} while (++tries < 50000);
