+#include <time.h>
 /*
  * FastRPC Example
  *
@@ -233,6 +234,21 @@ err:
 	return NULL;
 }
 
+static int attach_retry(int fd, int sns)
+{
+	int ret, tries = 0;
+	struct timespec ts = {0, 50000};
+	do {
+		ret = ioctl(fd, sns ? FASTRPC_IOCTL_INIT_ATTACH_SNS : FASTRPC_IOCTL_INIT_ATTACH, NULL);
+		if (!ret)
+			return 0;
+		if (errno != EPERM)
+			return ret;
+		nanosleep(&ts, NULL);
+	} while (++tries < 2000);
+	return ret;
+}
+
 int main(int argc, char* argv[])
 {
 	char *fastrpc_node = NULL;
@@ -287,16 +303,27 @@ int main(int argc, char* argv[])
 
