@@ -521,7 +521,6 @@ handle_generic_method_call (SensorData            *data,
 							   data,
 							   NULL);
 		g_hash_table_insert (ht, g_strdup (sender), GUINT_TO_POINTER (watch_id));
-
 		if (driver_type_exists (data, driver_type)) {
 			SensorDevice *sensor_device = DEVICE_FOR_TYPE(driver_type);
 
@@ -756,17 +755,23 @@ name_acquired_handler (GDBusConnection *connection,
 	SensorData *data = user_data;
 	guint i;
 
-	if (!find_sensors (data->client, data))
-		goto bail;
+	/* PATCH(2026-11-11): always initialize the delayed-invocation state and
+	 * subscribe to hotplug (uevent) events, even when no sensor is present yet.
+	 * Upstream only connected the uevent handler when find_sensors() succeeded,
+	 * but our daemon is started early (D-Bus activation) before the SSC PD is
+	 * up, so the device is hotplugged later and must be picked up here. */
+	for (i = 0; i < NUM_SENSOR_TYPES; i++)
+		data->sensor_startup_dbus_invocations_delayed[i] = g_ptr_array_new ();
 
 	g_signal_connect (G_OBJECT (data->client), "uevent",
 			  G_CALLBACK (sensor_changes), data);
 
+	if (!find_sensors (data->client, data))
+		goto bail;
+
 	for (i = 0; i < NUM_SENSOR_TYPES; i++) {
 		SensorDevice *sensor_device;
 
-		data->sensor_startup_dbus_invocations_delayed[i] = g_ptr_array_new ();
-
 		if (!driver_type_exists (data, i))
 			continue;
 
@@ -779,6 +784,14 @@ name_acquired_handler (GDBusConnection *connection,
 		}
 
 		DEVICE_FOR_TYPE(i) = sensor_device;
+
+		/* claims arrived before the startup enumeration: start polling now */
+
+		if (g_hash_table_size (data->clients[i]) > 0) {
+
+			driver_set_polling (sensor_device, TRUE);
+
+		}
 	}
 
 	if (!any_sensors_left (data))
@@ -789,9 +802,13 @@ name_acquired_handler (GDBusConnection *connection,
 	return;
 
 bail:
-	data->ret = 0;
-	g_message ("No sensors or missing kernel drivers for the sensors. Exiting");
-	g_main_loop_quit (data->loop);
+	/* PATCH(2026-11-11): keep running and wait for the SSC device to hotplug.
+	 * The sensors PD/fastrpc device only appears after the SLPI + hexagonrpcd
+	 * stack is up, so exiting here makes the daemon depend on an external
+	 * restart. Staying alive lets the udev hotplug path register sensors and
+	 * start polling for claims that arrived earlier. */
+	g_message ("No sensors found at startup; staying alive waiting for hotplug (patched)");
+	return;
 }
 
 static gboolean
@@ -1076,7 +1093,10 @@ sensor_changes (GUdevClient *client,
 		}
 
 		if (!any_sensors_left (data))
-			g_main_loop_quit (data->loop);
+			/* PATCH(2026-11-11): do not exit when the PD crashes/removes the
