    # ------------------------------------------------------------- protocol
    def _read_loop(self):
        try:
            stream = os.fdopen(
                FD, "r", encoding="utf-8", errors="replace", buffering=1
            )
        except OSError as exc:
            log("fd3 open failed: %r" % (exc,))
            GLib.idle_add(self._on_eof, "fd3-open-failed")
            return
        try:
            for line in stream:
                line = line.strip()
                if not line:
                    continue
                try:
                    msg = json.loads(line)
                except Exception:
                    log("rx malformed line: %r" % (line[:120],))
                    continue
                if not isinstance(msg, dict):
                    log("rx non-object json ignored")
                    continue
                op = msg.get("op")
                detail = ""
                if op in ("fingerprint_result", "password_result"):
                    detail = " ok=%r text=%r" % (
                        msg.get("ok"),
                        str(msg.get("text", ""))[:80],
                    )
                elif op in ("fingerprint_wait", "password", "info", "success", "start"):
                    detail = " text=%r" % (str(msg.get("text", ""))[:80],)
                    if op == "start":
                        detail = " service=%r" % (msg.get("service"),)
                    if op == "password":
                        detail += " allow_fingerprint=%r attempt=%r" % (
                            msg.get("allow_fingerprint", True),
                            msg.get("attempt"),
                        )
                log("rx op=%r%s" % (op, detail))
                GLib.idle_add(self._on_msg, msg)
        except OSError as exc:
            log("reader OSError: %r" % (exc,))
        finally:
            log("fd3 EOF")
            GLib.idle_add(self._on_eof, "eof")

    def _on_msg(self, msg):
        if self._closing:
            return False
        if not self._ready_sent:
            # Buffer until the window is mapped; ready must be the first
            # event the parent sees.
            self._pending.append(msg)
            return False
        self._handle(msg)
        return False

    def _handle(self, msg):
        op = msg.get("op")
        if op == "start":
            service = str(msg.get("service") or "").strip()
            if service:
                self._service = service
                self.subtitle.set_text("服务：" + service)
                self.subtitle.set_visible(True)
            self.show_fingerprint("请按指纹…")
        elif op == "fingerprint_wait":
            self.show_fingerprint(str(msg.get("text") or "请按指纹…"))
        elif op == "fingerprint_result":
            self.spinner.stop()
            self.spinner_row.set_visible(False)
            self._verifying = False
            if msg.get("ok"):
                self.show_success(str(msg.get("text") or "指纹验证成功"))
            else:
                text = str(msg.get("text") or "指纹不匹配")
                self._mode = "fingerprint"
                self.title.set_text("指纹验证")
                self.status.set_text("请再次按指纹…")
                self._set_detail(text, "error")
                self._show_switch("使用密码", visible=True, sensitive=True)
                self.entry.set_sensitive(True)
                self.pwbtn.set_sensitive(True)
        elif op == "password":
            self.show_password(msg)
        elif op == "password_result":
            self._verifying = False
            if msg.get("ok"):
                self.show_success(str(msg.get("text") or "密码验证成功"))
            else:
                self._mode = "password"
                self.title.set_text("密码验证")
                self.status.set_text("请输入密码")
                self._set_detail(str(msg.get("text") or "密码错误"), "error")
                self._password_ready()
                self.spinner.stop()
                self.spinner_row.set_visible(False)
        elif op == "info":
            text = str(msg.get("text") or "")
            if _is_error_text(text):
                self._set_detail(text, "error")
            elif text:
                self.status.set_text(text)
        elif op == "success":
            self.show_success(str(msg.get("text") or "验证通过"))
        else:
            log("rx unknown op=%r ignored" % (op,))

    # ------------------------------------------------------- state helpers
    def _set_detail(self, text, kind="normal"):
        text = (text or "").strip()
        self.detail.remove_css_class("bioauth-error")
        self.detail.remove_css_class("bioauth-info")
        self.detail.set_text(text)
        self.detail.set_visible(bool(text))
        if text and kind == "error":
            self.detail.add_css_class("bioauth-error")
        elif text and kind == "info":
            self.detail.add_css_class("bioauth-info")

    def _set_status(self, text, kind="normal"):
        self.status.remove_css_class("bioauth-ok")
        self.status.set_text(text)
        if kind == "ok":
            self.status.add_css_class("bioauth-ok")

    def _show_switch(self, label, visible=True, sensitive=True):
        self.switch_btn.set_label(label)
        self.switch_btn.set_visible(visible)
        self.switch_btn.set_sensitive(sensitive)

    def _password_ready(self):
        self._verifying = False
        self.pwrow.set_visible(True)
        self.entry.set_visible(True)
        self.entry.set_sensitive(True)
        self.pwbtn.set_visible(True)
        self.pwbtn.set_sensitive(True)
        self.entry.set_text("")
        self.entry.grab_focus()

    def show_fingerprint(self, text):
        if self._success:
            return
        previous = self._mode
        self._mode = "fingerprint"
        self._verifying = False
        self.title.set_text("指纹验证")
        self._set_status(text or "请按指纹…")
        if previous != "fingerprint" and previous != "switching":
            self._set_detail("", "normal")
        self.pwrow.set_visible(False)
        self.entry.set_sensitive(True)
        self.pwbtn.set_sensitive(True)
        self._show_switch("使用密码", visible=True, sensitive=True)
        self.cancel_btn.set_visible(True)
        self.spinner_row.set_visible(True)
        self.spinner.start()

    def show_password(self, msg):
        if self._success:
            return
        self._mode = "password"
        self._allow_fingerprint = bool(msg.get("allow_fingerprint", True))
        self._attempt = msg.get("attempt")
        if self._attempt is not None:
            try:
                self._attempt = int(self._attempt)
            except (TypeError, ValueError):
                self._attempt = None
        self.title.set_text("密码验证")
        self._set_status("请输入密码")
        text = str(msg.get("text") or "").strip()
        if text and _is_error_text(text):
            self._set_detail(text, "error")
        self.spinner.stop()
        self.spinner_row.set_visible(False)
        self._password_ready()
        self.cancel_btn.set_visible(True)
        self._show_switch(
            "使用指纹",
            visible=self._allow_fingerprint,
            sensitive=self._allow_fingerprint,
        )

    def show_success(self, text):
        if self._success or self._closing:
            return
        self._success = True
        text = (text or "").strip()
        self._mode = "success"
        self.title.set_text("验证通过")
        self.title.add_css_class("bioauth-ok")
        self.icon.set_from_icon_name("object-select-symbolic")
        self.icon.add_css_class("bioauth-ok")
        if text and not any(key in text for key in _SUCCESS_TEXTS):
            self._set_status(text, "ok")
        else:
            self.status.set_text("")
        self._set_detail("", "normal")
        self.spinner.stop()
        self.spinner_row.set_visible(False)
        self.pwrow.set_visible(False)
        self.footer.set_visible(False)
        self._show_switch("", visible=False, sensitive=False)
        self.cancel_btn.set_visible(False)
        log("success shown; arming %d ms close timer" % SUCCESS_DWELL_MS)
        self._success_timer_id = GLib.timeout_add(
            SUCCESS_DWELL_MS, self._on_success_timeout
        )

    def _on_success_timeout(self):
        self._success_timer_id = 0
        log("success dwell elapsed")
        self._finish("success")
        return False

    # --------------------------------------------------------- user input
    def on_switch(self, *_):
        if self._success or self._closing:
            return
        if self._mode == "fingerprint":
            self._mode = "switching"
            self._show_switch("使用密码", visible=True, sensitive=False)
            self._set_status("正在切换到密码验证…")
            send({"event": "switch_password"})
        elif self._mode == "password" and self._allow_fingerprint:
            self._mode = "switching"
            self._show_switch("使用指纹", visible=True, sensitive=False)
            self._set_status("正在切换到指纹验证…")
            self.spinner_row.set_visible(True)
            self.spinner.start()
            send({"event": "switch_fingerprint"})

    def on_password(self, *_):
        if self._success or self._closing:
            return
        if self._mode != "password" or self._verifying:
            # Stale double-submit: PAM already has a password in flight.
            return
        value = self.entry.get_text()
        if not value:
            self.entry.grab_focus()
            return
        self._verifying = True
        self._mode = "password"
        self.entry.set_text("")
        self.entry.set_sensitive(False)
        self.pwbtn.set_sensitive(False)
        self._set_status("正在验证密码…")
        self.spinner_row.set_visible(True)
        self.spinner.start()
        event = {
            "event": "password",
            "value": base64.b64encode(value.encode("utf-8")).decode("ascii"),
        }
        if self._attempt is not None:
            event["attempt"] = self._attempt
        send(event)
        log("password submitted (value redacted, attempt=%r)" % (self._attempt,))

    def _on_key(self, controller, keyval, keycode, state):
        if keyval == Gdk.KEY_Escape:
            self._cancel_and_close("escape")
            return True
        return False

    def _on_close_request(self, *_):
        log("close-request")
        self._cancel_and_close("close-request")
        return True  # we destroy ourselves in _finish()

    # ------------------------------------------------------------ lifecycle
    def _on_map(self, *_):
        if self._mapped:
            return
        self._mapped = True
        log("window mapped")
        if self._map_deadline_id:
            try:
                GLib.source_remove(self._map_deadline_id)
            except Exception:
                pass
            self._map_deadline_id = 0
        GLib.idle_add(self._emit_ready)

    def _emit_ready(self):
        if self._ready_sent or self._closing:
            return False
        self._ready_sent = True
        log("window ready; sending ready event proto=%d" % PROTO)
        send({"event": "ready", "proto": PROTO})
        pending, self._pending = self._pending, []
        for msg in pending:
            self._handle(msg)
        return False

    def _on_map_deadline(self):
        self._map_deadline_id = 0
        if self._mapped or self._closing:
            return False
        log("window did not map within %d s; aborting without ready" % MAP_DEADLINE_S)
        self._finish("map-deadline")
        return False

    def _on_eof(self, reason):
        if self._closing:
            return False
        if not self._ready_sent:
            log("EOF before ready (%s); exiting" % reason)
            self._finish("eof-before-ready")
            return False
        if self._success:
            log("EOF during success dwell; keeping green until timer")
            return False
        log("EOF without success (%s); exiting" % reason)
        self._finish("eof")
        return False

    def _on_timeout(self):
        self._timeout_id = 0
        log("safety timeout reached; cancelling")
        if not self._success:
            send({"event": "cancel"})
        self._finish("timeout")
        return False

    def _cancel_and_close(self, reason):
        if self._closing:
            return
        if not self._success:
            send({"event": "cancel"})
        self._finish(reason)

    def _on_destroy(self, *_):
        log("window destroy signal")
        self._quit_loop()

    def _quit_loop(self):
        try:
            if self._loop.is_running():
                self._loop.quit()
        except Exception:
            log("loop quit failed: %r" % (traceback.format_exc(),))

    def _finish(self, reason):
        if self._closing:
            return
        self._closing = True
        log("finish reason=%r" % (reason,))
        for attr in ("_timeout_id", "_map_deadline_id", "_success_timer_id"):
            source_id = getattr(self, attr, 0)
            if source_id:
                try:
                    GLib.source_remove(source_id)
                except Exception:
                    pass
                setattr(self, attr, 0)
        try:
            self.destroy()  # not close(): close() from a timeout does not die
        except Exception:
            log("destroy failed: %r" % (traceback.format_exc(),))
        self._quit_loop()

    def run(self):
        timeout = _timeout_seconds()
        if timeout > 0:
            self._timeout_id = GLib.timeout_add(
                int(round(timeout * 1000)), self._on_timeout
            )
            log("safety timeout armed: %ss" % timeout)
        else:
            log("safety timeout disabled by BIOAUTH_UI_TIMEOUT=0")
        self._map_deadline_id = GLib.timeout_add_seconds(
            MAP_DEADLINE_S, self._on_map_deadline
        )
        log("presenting fullscreen window")
        self.fullscreen()
        self.present()
        log("entering main loop")
        self._loop.run()
        log("main loop exited")
        return 0


def send(obj):
    data = (json.dumps(obj, ensure_ascii=False) + "\n").encode("utf-8")
    try:
        with write_lock:
            os.write(FD, data)
    except OSError as exc:
        log("write fd3 failed: %r" % (exc,))
        return False
    if obj.get("event") == "password":
        log("tx event=password <value redacted>")
    else:
        log("tx event=%r" % (obj.get("event"),))
    return True


def main():
    GLib.set_prgname("bioauth-ui")
    GLib.set_application_name("bioauth")
    try:
        Gtk.init()
    except Exception as exc:
        log("Gtk.init failed: %r" % (exc,))
        print("bioauth-ui: GTK init failed: %s" % (exc,), file=sys.stderr)
        return 1
    log("Gtk.init ok")

    provider = Gtk.CssProvider()
    try:
        provider.load_from_data(CSS)
    except Exception as exc:
        log("CSS load failed: %r" % (exc,))
    display = Gdk.Display.get_default()
    if display is None:
        log("no Gdk display available")
        print("bioauth-ui: no display available", file=sys.stderr)
        return 1
    Gtk.StyleContext.add_provider_for_display(
        display, provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION
    )
    window = AuthWindow()
    return window.run()


if __name__ == "__main__":
    try:
        sys.exit(main())
    except SystemExit:
        raise
    except BaseException:
        log("uncaught exception: %s" % (traceback.format_exc(),))
        raise
