#!/usr/bin/python3
"""bioauth-ui - single-window, fullscreen GTK4 authentication overlay.

Presentation
------------
One undecorated fullscreen window owned by the calling user: a dark overlay
covering the whole output with a centered authentication card (UAC /
pkexec-agent style).  The window is a plain Wayland client: the compositor
decides stacking, so this is *presentation* only, not a secure desktop.  See
bioauth/uac-secure-screen-20261113.md for the honest threat-model discussion.

Why the overlay background is opaque near-black instead of a translucent dim:
on this GNOME 46 / mutter 46.2 Wayland session a *fullscreen* GTK4 client
with a translucent background is direct-scanned-out (unredirected): its
transparent pixels are composited against black, never against the desktop,
so the visible result is a solid black screen with a black card (measured:
uniform RGB(5,6,7) over a desktop that was RGB(128,132,136); the same window
made non-fullscreen at 1280x800 composites the dim exactly as expected,
RGB(54,56,59)).  A fullscreen client also cannot be made translucent with
Gtk.Window.set_opacity(0.99).  Therefore the overlay deliberately paints an
opaque near-black surface - the closest a plain client can get to the Windows
UAC secure desktop (which also shows a frozen dimmed snapshot, not live
content) - and covers the whole output including the GNOME top bar.

Flow
----
Fingerprint is armed immediately (no initial choice).  The card always offers
a switch button: fingerprint -> password, password -> fingerprint (when
allowed).  Fingerprint retries are driven by the PAM module; the UI only
displays state and forwards user choices.

Protocol (newline-delimited JSON on fd 3, unchanged except "ready")
-------------------------------------------------------------------
  parent -> ui :
      {"op":"start","service":...}
      {"op":"fingerprint_wait","text":...}
      {"op":"fingerprint_result","ok":...,"text":...}
      {"op":"password","text":...,"allow_fingerprint":true|false}
      {"op":"password_result","ok":...,"text":...}
      {"op":"info","text":...}
      {"op":"success","text":...}
  ui -> parent :
      {"event":"ready","proto":2}    # exactly once, after the window mapped
      {"event":"switch_password"}
      {"event":"switch_fingerprint"}
      {"event":"password","value":"<base64>","attempt":N}
      {"event":"cancel"}

  The password op may carry an "attempt" prompt id (integer); the helper
  stores the last one and echoes it in the submit event so PAM can discard
  stale submissions.  If no attempt id was received it is omitted.

Lifecycle contract
------------------
* "ready" is sent exactly once, from the first idle callback after the
  Gtk.Window is mapped (i.e. the first frame has been queued).  If the window
  never maps the helper does not send it; it logs that fact (BIOAUTH_UI_LOG)
  and exits after MAP_DEADLINE_S.  If GTK init fails the helper logs and exits
  non-zero without ever sending "ready".
* On {"op":"success"} (or a successful fingerprint_result) the card turns
  green immediately and a single ~1000 ms timer calls destroy() + main-loop
  quit.  The helper does NOT wait for EOF on success and does not close
  before the timer.  Duplicate success/fingerprint_result-ok messages never
  schedule a second timer.
* On EOF from the parent (dead PAM module) the helper exits promptly, unless
  the green success dwell is already running.
* A 180 s safety timeout (BIOAUTH_UI_TIMEOUT overrides, for tests only)
  sends {"event":"cancel"} and exits.
* Closing the window (Escape, 取消, WM close) sends {"event":"cancel"} and
  exits.  destroy() + loop.quit() is used everywhere; Gtk.Window.close() is
  never called from a timeout because that does not reliably destroy a
  GTK4 window under Wayland (reproduced by the Lead).

Environment (optional, diagnostics only)
----------------------------------------
  BIOAUTH_UI_LOG=/path/file  append timestamped lines (0600 on create) for
                             start / gtk init / ready / every rx op / every
                             tx event / destroy / exceptions.  Password
                             values and submitted secrets are never logged.
                             An unwritable path is ignored.
  BIOAUTH_UI_TIMEOUT=<sec>   test hook overriding the 180 s safety timeout
                             (0 disables it).  Not used by the PAM module.
"""
import base64
import datetime
import json
import os
import sys
import threading
import traceback

FD = 3
PROTO = 2
DEFAULT_TIMEOUT_S = 180.0
MAP_DEADLINE_S = 10
SUCCESS_DWELL_MS = 1000

_LOG_PATH = os.environ.get("BIOAUTH_UI_LOG", "") or ""
_log_lock = threading.Lock()


def log(message):
    """Append one timestamped diagnostic line if BIOAUTH_UI_LOG is set.

    Must never raise: a broken/unwritable log path must not break auth.
    """
    if not _LOG_PATH:
        return
    try:
        stamp = datetime.datetime.now().astimezone().isoformat(timespec="milliseconds")
        line = "%s [bioauth-ui:%d] %s\n" % (stamp, os.getpid(), message)
        with _log_lock:
            fd = os.open(_LOG_PATH, os.O_WRONLY | os.O_CREAT | os.O_APPEND, 0o600)
            try:
                os.write(fd, line.encode("utf-8", "replace"))
            finally:
                os.close(fd)
    except Exception:
        pass


def _timeout_seconds():
    raw = os.environ.get("BIOAUTH_UI_TIMEOUT", "")
    if not raw:
        return DEFAULT_TIMEOUT_S
    try:
        value = float(raw)
    except ValueError:
        log("invalid BIOAUTH_UI_TIMEOUT=%r, using %s" % (raw, DEFAULT_TIMEOUT_S))
        return DEFAULT_TIMEOUT_S
    return value if value > 0 else 0.0


