[Unit]
Description=Generic biometric authentication daemon (PAM)
Documentation=file:///usr/local/share/doc/bioauth/README.md
After=dbus.socket systemd-user-sessions.service
Wants=dbus.socket

[Service]
Type=simple
ExecStart=/usr/local/libexec/bioauthd --socket /run/bioauth.sock --state /var/lib/bioauth/state.json
Environment=BIOAUTH_BACKEND=fprintd
StateDirectory=bioauth
StateDirectoryMode=0700
Restart=on-failure
RestartSec=3s
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ProtectKernelTunables=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_LOCAL
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
