--- /dev/null
+++ b/drivers/media/i2c/cn3927v.c
@@ -0,0 +1,240 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Minimal mainline V4L2 VCM driver for ChipNext CN3927V.
+ * Based on the protocol from the Rockchip cn3927v driver.
+ */
+#include <linux/delay.h>
+#include <linux/i2c.h>
+#include <linux/module.h>
+#include <linux/regulator/consumer.h>
+#include <media/v4l2-ctrls.h>
+#include <media/v4l2-device.h>
+#include <media/v4l2-subdev.h>
+
+#define CN3927V_MAX_POS 1023
+#define CN3927V_STEP_MODE 0x0d
+
+struct cn3927v {
+	struct v4l2_subdev sd;
+	struct v4l2_ctrl_handler ctrl_handler;
+	struct v4l2_ctrl *focus;
+	struct regulator *avdd;
+	u32 pos;
+};
+
+static int cn3927v_write(struct cn3927v *priv, u8 msb, u8 lsb)
+{
+	struct i2c_client *client = v4l2_get_subdevdata(&priv->sd);
+	u8 buf[2] = { msb, lsb };
+	int ret;
+
+	ret = i2c_master_send(client, buf, sizeof(buf));
+	if (ret != sizeof(buf)) {
+		dev_err(&client->dev, "i2c write %02x %02x failed: %d\n",
+			msb, lsb, ret);
+		return ret < 0 ? ret : -EIO;
+	}
+	usleep_range(50, 100);
+	return 0;
+}
+
+static int cn3927v_init(struct cn3927v *priv)
+{
+	struct i2c_client *client = v4l2_get_subdevdata(&priv->sd);
+	int ret;
+
+	usleep_range(1000, 1200);
+	ret = cn3927v_write(priv, 0xec, 0xa3);
+	if (ret)
+		return ret;
+	ret = cn3927v_write(priv, 0xa1, 0x04); /* MCLK=0, LSC, no DLC */
+	if (ret)
+		return ret;
+	ret = cn3927v_write(priv, 0xf2, 0x00); /* t_src */
+	if (ret)
+		return ret;
+	ret = cn3927v_write(priv, 0xdc, 0x51);
+	if (ret)
+		return ret;
+	ret = cn3927v_write(priv, 0xdf, 0x5b);
+	if (ret)
+		return ret;
+
+	dev_info(&client->dev, "initialized, DAC=%u\n", priv->pos);
+	return 0;
+}
+
+static int cn3927v_set_focus(struct cn3927v *priv, u32 pos)
+{
+	u32 dac;
+	u8 msb, lsb;
+
+	/* Android maps logical 0..1023 to DAC 853..0; keep the same direction. */
+	dac = ((CN3927V_MAX_POS - pos) * 100U / CN3927V_MAX_POS) * 1023U / 100U;
+	if (dac > CN3927V_MAX_POS)
+		dac = CN3927V_MAX_POS;
+
+	msb = (dac >> 4) & 0x3f;
+	lsb = ((dac & 0x0f) << 4) | CN3927V_STEP_MODE;
+	priv->pos = pos;
+
+	return cn3927v_write(priv, msb, lsb);
+}
+
+static int cn3927v_s_ctrl(struct v4l2_ctrl *ctrl)
+{
+	struct cn3927v *priv = container_of(ctrl->handler, struct cn3927v,
+					    ctrl_handler);
+
+	if (ctrl->id != V4L2_CID_FOCUS_ABSOLUTE)
+		return -EINVAL;
+
+	return cn3927v_set_focus(priv, ctrl->val);
+}
+
+static const struct v4l2_subdev_ops cn3927v_subdev_ops = {
+};
+
+static const struct v4l2_ctrl_ops cn3927v_ctrl_ops = {
+	.s_ctrl = cn3927v_s_ctrl,
+};
+
+static ssize_t focus_show(struct device *dev, struct device_attribute *attr,
+			 char *buf)
+{
+	struct cn3927v *priv = dev_get_drvdata(dev);
+
+	return sysfs_emit(buf, "%u\n", priv->pos);
+}
+
+static ssize_t focus_store(struct device *dev, struct device_attribute *attr,
+			   const char *buf, size_t count)
+{
+	struct cn3927v *priv = dev_get_drvdata(dev);
+	unsigned int pos;
+	int ret;
+
+	ret = kstrtouint(buf, 0, &pos);
+	if (ret)
+		return ret;
+	if (pos > CN3927V_MAX_POS)
+		return -EINVAL;
+	ret = cn3927v_set_focus(priv, pos);
+	return ret ? ret : count;
+}
+static DEVICE_ATTR_RW(focus);
+
+static int cn3927v_probe(struct i2c_client *client)
+{
+	struct cn3927v *priv;
+	int ret;
+
+	priv = devm_kzalloc(&client->dev, sizeof(*priv), GFP_KERNEL);
+	if (!priv)
+		return -ENOMEM;
+
+	v4l2_i2c_subdev_init(&priv->sd, client, &cn3927v_subdev_ops);
+	priv->sd.flags |= V4L2_SUBDEV_FL_HAS_DEVNODE;
+	priv->sd.entity.function = MEDIA_ENT_F_LENS;
+
+	priv->avdd = devm_regulator_get_optional(&client->dev, "avdd");
+	if (IS_ERR(priv->avdd)) {
+		ret = PTR_ERR(priv->avdd);
+		priv->avdd = NULL;
+		if (ret != -ENODEV)
+			return dev_err_probe(&client->dev, ret, "avdd\n");
+	}
+	if (priv->avdd) {
+		ret = regulator_enable(priv->avdd);
+		if (ret)
+			return dev_err_probe(&client->dev, ret, "enable avdd\n");
+	}
+
+	usleep_range(1000, 1200);
+	ret = cn3927v_init(priv);
+	if (ret)
+		goto err_avdd;
+
+	v4l2_ctrl_handler_init(&priv->ctrl_handler, 1);
+	priv->focus = v4l2_ctrl_new_std(&priv->ctrl_handler, &cn3927v_ctrl_ops,
+					V4L2_CID_FOCUS_ABSOLUTE, 0,
+					CN3927V_MAX_POS, 1, CN3927V_MAX_POS);
+	if (priv->ctrl_handler.error) {
+		ret = priv->ctrl_handler.error;
+		goto err_ctrl;
+	}
+	priv->sd.ctrl_handler = &priv->ctrl_handler;
+
+	ret = media_entity_pads_init(&priv->sd.entity, 0, NULL);
+	if (ret)
+		goto err_ctrl;
+
+	ret = v4l2_async_register_subdev(&priv->sd);
+	if (ret)
+		goto err_media;
+
+	dev_set_drvdata(&client->dev, priv);
+	ret = device_create_file(&client->dev, &dev_attr_focus);
+	if (ret)
+		goto err_unregister;
+
+	dev_info(&client->dev, "CN3927V VCM ready on %s\n", client->name);
+	return 0;
+
+err_unregister:
+	v4l2_async_unregister_subdev(&priv->sd);
+	media_entity_cleanup(&priv->sd.entity);
+	v4l2_ctrl_handler_free(&priv->ctrl_handler);
+	if (priv->avdd)
+		regulator_disable(priv->avdd);
+	return ret;
+
+err_media:
+	media_entity_cleanup(&priv->sd.entity);
+err_ctrl:
+	v4l2_ctrl_handler_free(&priv->ctrl_handler);
+err_avdd:
+	if (priv->avdd)
+		regulator_disable(priv->avdd);
+	return ret;
+}
+
+static void cn3927v_remove(struct i2c_client *client)
+{
+	struct v4l2_subdev *sd = i2c_get_clientdata(client);
+	struct cn3927v *priv = container_of(sd, struct cn3927v, sd);
+
+	device_remove_file(&client->dev, &dev_attr_focus);
+	v4l2_async_unregister_subdev(sd);
+	media_entity_cleanup(&sd->entity);
+	v4l2_ctrl_handler_free(&priv->ctrl_handler);
+	if (priv->avdd)
+		regulator_disable(priv->avdd);
+}
+
+static const struct of_device_id cn3927v_of_match[] = {
+	{ .compatible = "chipnext,cn3927v" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, cn3927v_of_match);
+
+static const struct i2c_device_id cn3927v_id[] = {
+	{ "cn3927v", 0 },
+	{ }
+};
+MODULE_DEVICE_TABLE(i2c, cn3927v_id);
+
+static struct i2c_driver cn3927v_driver = {
+	.driver = {
+		.name = "cn3927v",
+		.of_match_table = cn3927v_of_match,
+	},
+	.probe = cn3927v_probe,
+	.remove = cn3927v_remove,
+	.id_table = cn3927v_id,
+};
+module_i2c_driver(cn3927v_driver);
+
+MODULE_AUTHOR("elish camera adaptation");
+MODULE_DESCRIPTION("ChipNext CN3927V VCM driver");
+MODULE_LICENSE("GPL");
