--- a/drivers/pinctrl/qcom/pinctrl-lpass-lpi.c
+++ b/drivers/pinctrl/qcom/pinctrl-lpass-lpi.c
@@ -500,8 +500,19 @@
 		return ret;
 
 	ret = clk_bulk_prepare_enable(MAX_LPI_NUM_CLKS, pctrl->clks);
-	if (ret)
+	if (ret) {
+		/*
+		 * SM8250: the LPI clocks are served by the ADSP via q6prm.
+		 * If the DSP firmware has not finished booting, the clock
+		 * enable request times out (-ETIMEDOUT). Defer instead of
+		 * failing hard, otherwise the pinctrl never binds, the USB
+		 * PHY defers forever and the pogo keyboard dies.
+		 */
+		if (ret == -ETIMEDOUT || ret == -EAGAIN || ret == -EBUSY)
+			return dev_err_probe(dev, -EPROBE_DEFER,
+					     "LPASS clocks not ready, deferring\n");
 		return dev_err_probe(dev, ret, "Can't enable clocks\n");
+	}
 
 	pctrl->desc.pctlops = &lpi_gpio_pinctrl_ops;
 	pctrl->desc.pmxops = &lpi_gpio_pinmux_ops;
